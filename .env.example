# ==============================================================================
# LIVE SUBTITLES & TRANSLATION ("ONDERTITELS") - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and adjust the values for your environment.
# Supported pipeline modes: "local" (Apple Silicon MLX), "cloud" (Google Cloud),
# or "runpod" (External NVIDIA GPU via WebSocket).

# ==============================================================================
# 1. Pipeline Mode Selection
# ==============================================================================
# Options:
#   local   - Local Apple Silicon inference (MLX-Whisper + Ollama LLM translation)
#   cloud   - Google Cloud Speech-to-Text streaming + Cloud Translation API
#   runpod  - Remote NVIDIA GPU worker running faster-whisper over WebSocket
PIPELINE_MODE=local

# ==============================================================================
# 2. Languages & 5-Column Display
# ==============================================================================
# Column 1: Source speech language code (BCP-47 tag, e.g. nl-NL, en-US, de-DE)
SOURCE_LANG=nl-NL

# Column 2: First target translation language (direct translation from Column 1)
TARGET_LANG_1=en

# Column 3: Second target translation language (direct translation from Column 1)
TARGET_LANG_2=ru

# Column 4: Third target language (chained back-translation from Column 2 -> Column 4)
TARGET_LANG_3=de

# Column 5: Fourth target language (chained back-translation from Column 3 -> Column 5)
TARGET_LANG_4=nl-NL

# Enable or disable columns 4 and 5 (true/false)
ENABLE_TRANS_3=true
ENABLE_TRANS_4=true

# Throttle interval (in seconds) between periodic interim translation dispatches
TRANSLATE_INTERVAL_SEC=10

# ==============================================================================
# 3. Google Cloud STT & Translation (when PIPELINE_MODE=cloud)
# ==============================================================================
# Path to your Google Cloud service account JSON credentials
GOOGLE_APPLICATION_CREDENTIALS=ondertitels-486017-0ee48ab1ba8d.json

# Google Cloud project ID
GOOGLE_PROJECT_ID=ondertitels-486017

# Minimum stability metric (0.0 to 1.0) before interim results are translated
STABILITY_THRESHOLD=0.8

# Minimum word count required before interim results are sent for translation
MIN_WORDS_FOR_STABILITY=5

# ==============================================================================
# 4. Local macOS Inference with Apple Silicon (when PIPELINE_MODE=local)
# ==============================================================================
# MLX-Whisper model identifier from Hugging Face:
# e.g., mlx-community/whisper-small-mlx, mlx-community/whisper-large-v3-mlx
WHISPER_MODEL=mlx-community/whisper-small-mlx

# Local Ollama LLM model for translation:
# e.g., aya-expanse:8b, qwen2.5:3b, llama3.1:8b
OLLAMA_MODEL=aya-expanse:8b

# Ollama API endpoint URL
OLLAMA_URL=http://localhost:11434

# ==============================================================================
# 5. RunPod Remote GPU STT (when PIPELINE_MODE=runpod)
# ==============================================================================
# RunPod API Key for pod discovery, auto-deployment, and auto-shutdown
RUNPOD_API_KEY=

# Auto-deploy or resume pod if no active pod is detected (true/false)
AUTO_DEPLOY_RUNPOD=false

# Template ID configured on RunPod with runpod-vertaal container
RUNPOD_TEMPLATE_ID=

# Network volume ID mounted to the pod (optional)
RUNPOD_VOLUME_ID=

# Preferred GPU model ID (e.g. "NVIDIA GeForce RTX 4090", "NVIDIA GeForce RTX 3090")
RUNPOD_GPU_ID=NVIDIA GeForce RTX 4090

# Target Data Center ID (e.g. EU-RO-1, US-KS-1; leave empty for any available region)
RUNPOD_DATA_CENTER_ID=

# Whisper model to load on the RunPod worker (small, medium, large-v3)
RUNPOD_WHISPER_MODEL=large-v3

# Inactivity auto-shutdown timeout for the RunPod worker (in seconds, e.g. 5400 = 90 mins)
MAX_RUN_TIME_SEC=5400

# Manual WebSocket URL override (bypasses RunPod API discovery if set, e.g. wss://<pod-id>-8000.proxy.runpod.net/stream)
RUNPOD_WSS_URL=

# ==============================================================================
# 6. Audio Devices, VAD, Network Streaming & Timing
# ==============================================================================
# Preferred input device name to auto-select on startup (e.g. "Voicemeeter Out B1")
DEFAULT_DEVICE_NAME=Voicemeeter Out B1

# WebRTC VAD silence threshold (in milliseconds) to detect sentence boundary pauses
SILENCE_THRESHOLD_MS=400

# Forced flush timeout (in milliseconds) when speaker pauses after a short utterance
MAX_SILENCE_FLUSH_MS=2000

# Minimum audio duration (in seconds) required before chunk transcription in local mode
MIN_LOCAL_CHUNK_S=10.0

# Maximum audio duration (in seconds) hard cap before forcing transcription
MAX_LOCAL_CHUNK_S=25.0

# Maximum session duration (in minutes) before auto-pausing the stream
MAX_SESSION_MINUTES=30

# Path to demo audio file used when Demo File source is selected
DEMO_FILE_PATH=2025-12-14-1000.wav

# Target VBAN stream name to listen for over UDP port 6980 when VBAN is selected
VBAN_STREAM_NAME=ringleiding
