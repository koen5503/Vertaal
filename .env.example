# --- Pipeline Mode ---
# "local" (MLX-Whisper + Ollama) or "cloud" (Google Cloud)
PIPELINE_MODE=local

# --- Google Cloud Config (if PIPELINE_MODE=cloud) ---
GOOGLE_APPLICATION_CREDENTIALS=ondertitels-486017-0ee48ab1ba8d.json
GOOGLE_PROJECT_ID=ondertitels-486017

# --- Local Config (if PIPELINE_MODE=local) ---
WHISPER_MODEL=mlx-community/whisper-small-mlx
OLLAMA_MODEL=aya-expanse:8b
OLLAMA_URL=http://localhost:11434
MIN_LOCAL_CHUNK_S=10.0
MAX_SILENCE_FLUSH_MS=2000

# --- General ---
# Dictates the server auto-pause timeout (in minutes)
MAX_SESSION_MINUTES=30
SOURCE_LANG=nl-NL
TARGET_LANG_1=en
TARGET_LANG_2=fr
DEMO_FILE_PATH=2025-12-14-1000.wav
